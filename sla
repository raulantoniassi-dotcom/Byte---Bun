.imagens {
  border: 0px solid #d8e6e2;
  height: 200px;
  width: 650px;
  display: flex;
  gap: 20px;
}

.imagens img {
  width: 200px;
  height: 200px;
  object-fit: cover;
  border-radius: 10px;
  align-self: center;
  justify-self: center;
}

.Pao {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.textos {
  gap: 60px;
  border: 0px solid #d8e6e2;
  position: relative;
  margin-top: -40px;
  width: 90%;
  display: flex;
  flex-direction: row;
  gap: 20px;
  align-items: center;
  justify-content: center;
}

#poes,
#poes2,
#poes3 {

  display: flex;
  text-align: center;
  font-size: 25px;
  color: #5c5c5c;
  margin-top: 10px;
  flex-direction: column;

}
